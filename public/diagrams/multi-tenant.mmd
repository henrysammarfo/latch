%%{init: {"theme":"dark","flowchart":{"curve":"basis","htmlLabels":true},"themeVariables":{"primaryColor":"#1B3A28","primaryTextColor":"#F4F7FA","primaryBorderColor":"#7CFFB2","lineColor":"#7CFFB2","secondaryColor":"#14301F","tertiaryColor":"#0F241A","fontFamily":"ui-sans-serif, system-ui, sans-serif","fontSize":"16px"}} }%%
flowchart TB
  classDef core fill:#1B3A28,stroke:#7CFFB2,color:#F4F7FA,stroke-width:2px
  classDef gate fill:#14301F,stroke:#9AA7B8,color:#F4F7FA,stroke-width:1.5px
  classDef ext fill:#0F241A,stroke:#7CFFB2,color:#B7C3D1,stroke-width:1.5px

  subgraph WS["Workspace (tenant boundary)"]
    direction TB
    U["User<br/>email + password"]:::gate --> W[Workspace]:::core
    W --> AG[Agents]:::gate
    W --> CX[Connections]:::gate
    AG --> PL[Plays]:::gate
  end

  CX --> SL[Slack]:::ext
  CX --> GO["Google<br/>Sheet · Cal · Gmail"]:::ext
  CX --> ST[Stripe webhook]:::ext
  PL --> EN[SavePlay engine]:::core
  EN --> SL
  EN --> GO
  EN --> EV[Evals / goldens]:::ext
