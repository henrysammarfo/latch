# LATCH Empire — copy to .env (gitignored). Never commit real values.

# Research / LLM
TAVILY_API_KEY=
TINYFISH_API_KEY=
AGENTROUTER_API_KEY=
AGENT_ROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENT_ROUTER_BASE=https://agentrouter.org
AGENTROUTER_MODEL=deepseek-v4-flash
# Cursor Cloud only — do NOT set on Vercel production:
AGENT_ROUTER_HTTP_PROXY=socks5h://127.0.0.1:9050

# Slack
SLACK_BOT_TOKEN=
SLACK_CS_CHANNEL_ID=

# Google OAuth + APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_CALENDAR_ID=primary

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Runtime
LATCH_MODE=dry_run
LATCH_KILL_SWITCH=false
LATCH_MAX_ARR_AUTO=50000
LATCH_PUBLIC_POKE_TOKEN=
LATCH_LLM_DRAFT=false
SESSION_SECRET=
